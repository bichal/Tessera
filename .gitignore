# >>> bichal-build-logic: managed by `bichal sync`, add your own entries below the block
.*/
!.github/
build/
build-native/
versions/
run/
logs/
# generated from mod.stonecutter.properties.toml + the common TOML
stonecutter.properties.toml
# local secrets and settings (see bichal-build-logic/.env.example)
.env
repomix*
__pycache__/
# written by `bichal vendor` next to fetched sources
.vendored.json
# <<< bichal-build-logic

*.config.json
*.xml

# VENDOR (bc7enc_rdo)
native/vendor/bc7enc_rdo/*
!native/vendor/bc7enc_rdo/tessera_bridge.cpp
!native/vendor/bc7enc_rdo/LICENSE
!native/vendor/bc7enc_rdo/VENDORING.md

# VENDOR (astc-encoder)
native/vendor/astcenc/*
!native/vendor/astcenc/LICENSE
!native/vendor/astcenc/VENDORING.md

# Native binaries are never committed: CI builds them per platform
# (bichal-build-logic mod-ci.yml, [natives.tessera_bridge]); see README, "Native encoder".
*.so
*.dll
*.dylib
*.lib
*.exp
*.pdb
*.a
*.o
*.obj
